---
import Doc from '../layouts/Doc.astro';
import { HOME_ID, SEGMENTS, hrefFor } from '../lib/nav';
---
<Doc id={HOME_ID} title="Vulnetix documentation" description="User and reference documentation for every Vulnetix product.">
  <table>
    <thead><tr><th>Product</th><th>What it covers</th></tr></thead>
    <tbody>
      {SEGMENTS.map((s) => (
        <tr><td><a href={hrefFor(s.home)}>{s.title}</a></td><td>{s.summary}</td></tr>
      ))}
    </tbody>
  </table>
</Doc>
